ASSEMBLYAI_API_KEY=

# Necessária pra geração de ata via IA e pro Planner (/api/ata e /api/chat).
# Pegue uma chave grátis em https://aistudio.google.com/apikey
# Sem ela, a ata cai num fallback local heurístico (vazio em pt-BR).
GOOGLE_GENERATIVE_AI_API_KEY=

# Opcional: força um model ID específico do Gemini. Padrão: gemini-2.5-flash.
# Outros: gemini-2.5-pro, gemini-2.0-flash
GEMINI_MODEL=

# Opcional: usado como fallback em /api/ata quando Gemini Flash e Gemini Pro
# falharem com overload/rate-limit/503. Pegue uma chave em
# https://console.anthropic.com/ (precisa cadastrar e adicionar créditos).
# Sem isso, o fallback é só Gemini Flash → Gemini Pro.
ANTHROPIC_API_KEY=
# Opcional: força um Claude model ID. Padrão: claude-sonnet-4-6.
CLAUDE_MODEL=

# Firebase — usado pra Auth (login email/senha + Google OAuth) + Firestore (collection `users` com role).
# Storage NÃO é mais usado (substituído por Supabase Storage, ver abaixo).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Supabase — usado pra upload de áudio (Storage). Bucket: ver NEXT_PUBLIC_SUPABASE_AUDIO_BUCKET (padrão "audio").
# Pegue em Supabase Dashboard → Settings → API. anon/publishable key é segura no client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opcional: nome do bucket de áudios. Padrão: "audio".
NEXT_PUBLIC_SUPABASE_AUDIO_BUCKET=

NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_MICROSOFT_CLARITY_ID=
