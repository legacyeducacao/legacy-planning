ASSEMBLYAI_API_KEY=

# Necessária pra geração de ata via IA e pro Planner (/api/ata e /api/chat).
# Pegue uma chave grátis em https://aistudio.google.com/apikey
# Sem ela, a ata cai num fallback local heurístico (vazio em pt-BR).
GOOGLE_GENERATIVE_AI_API_KEY=

# Opcional: força um model ID específico. Padrão: gemini-2.5-flash.
# Outros: gemini-2.5-pro, gemini-2.0-flash
GEMINI_MODEL=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_MICROSOFT_CLARITY_ID=
